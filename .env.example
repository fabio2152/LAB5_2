# Copia este archivo como .env y completa los valores (el .env NO se sube a GitHub)

# --- Puerto en el que se publica la app (en AWS usa 80) ---
APP_PORT=8080

# --- Imagen de la app (Docker Hub) y memoria de Java (en una t3.micro usa -Xmx512m) ---
APP_IMAGE=fabio2152/marketing-ai:latest
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Djava.awt.headless=true

# --- Base de datos PostgreSQL (contenedor "db") ---
DB_NAME=marketing
DB_USER=marketing
DB_PASSWORD=cambia-esta-clave

# --- URL pública de la app (en AWS: http://<IP-publica-EC2>) ---
PUBLIC_BASE_URL=http://localhost:8080

# --- Claude (Anthropic): analiza la foto y escribe los 3 guiones ---
# Sin API key la app funciona en "modo demo" con guiones de ejemplo
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Amazon S3: URL pública HTTPS para las fotos y el video (Instagram la necesita) ---
# Déjalo vacío para guardar solo en disco
S3_BUCKET=
AWS_REGION=us-east-1
# Solo si NO usas un rol IAM en la EC2:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Instagram Graph API (cuenta profesional) ---
# Sin estos valores la publicación queda "simulada"
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v23.0
